{
  "name": "audit-extension",
  "displayName": "Audit Extension",
  "description": "Assisted code review and security auditing with a plugin-oriented architecture (Ansible, Docker, Packer, Python, JS, C/C++, HTML).",
  "version": "0.2.0",
  "publisher": "audit-lab",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Linters", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Audit Extension",
      "properties": {
        "audit.llm.mode": {
          "type": "string",
          "enum": ["local", "llm-local", "remote-agent"],
          "enumDescriptions": [
            "No code leaves the machine. Analysis via LSP/Tree-sitter/linters only.",
            "Connects to a local model (Ollama, LM Studio, vLLM). No data sent to the Internet.",
            "Remote agent (Windsurf). Disabled by default, requires explicit authorization."
          ],
          "default": "local",
          "description": "AI analysis mode."
        },
        "audit.llm.localEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Local model endpoint (llm-local mode)."
        },
        "audit.remoteAgent.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enables the remote agent connector (Windsurf). Keep disabled for sensitive projects."
        },
        "audit.exclusionGlobs": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/*.pem", "**/secrets.yml", "**/secrets.yaml", "**/inventory", "**/.env"],
          "description": "File patterns never transmitted to an external service."
        },
        "audit.obsidian.vaultPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Obsidian vault root. Empty disables export."
        },
        "audit.obsidian.knowledgeRoot": {
          "type": "string",
          "default": "5_Knowledges",
          "description": "Knowledge root folder inside the vault."
        },
        "audit.obsidian.defaultNoteType": {
          "type": "string",
          "enum": ["index", "flashcard", "cheatsheet", "gist", "slides", "groom"],
          "default": "gist",
          "description": "Default note type when exporting an audit note."
        },
        "audit.obsidian.knowledgeIndex": {
          "type": "string",
          "default": "",
          "description": "Index note referenced in each note's Knowledge-index field."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [{ "id": "audit-explorer", "title": "Audit", "icon": "$(shield)" }]
    },
    "views": {
      "audit-explorer": [
        { "id": "audit.annotations", "name": "Annotations" },
        { "id": "audit.bookmarks", "name": "Bookmarks" },
        { "id": "audit.trustGraph", "name": "Trust graph" },
        { "id": "audit.knowledge", "name": "Knowledge base" }
      ]
    },
    "commands": [
      { "command": "audit.scanWorkspace", "title": "Audit: Scan workspace", "icon": "$(search)" },
      { "command": "audit.addAnnotation", "title": "Audit: Add annotation" },
      { "command": "audit.editAnnotation", "title": "Audit: Edit annotation" },
      { "command": "audit.deleteAnnotation", "title": "Audit: Delete annotation" },
      { "command": "audit.showAnnotationHistory", "title": "Audit: Show annotation history" },
      { "command": "audit.toggleBookmark", "title": "Audit: Toggle bookmark" },
      { "command": "audit.gotoBookmark", "title": "Audit: Go to bookmark" },
      { "command": "audit.clearBookmarks", "title": "Audit: Clear bookmarks", "icon": "$(clear-all)" },
      { "command": "audit.setNodeState", "title": "Audit: Set trust-node state" },
      { "command": "audit.exportObsidian", "title": "Audit: Create Obsidian note" },
      { "command": "audit.syncObsidian", "title": "Audit: Sync notes to Obsidian", "icon": "$(sync)" },
      { "command": "audit.openObsidianNote", "title": "Audit: Open Obsidian note" },
      { "command": "audit.refreshViews", "title": "Audit: Refresh views", "icon": "$(refresh)" }
    ],
    "menus": {
      "view/title": [
        { "command": "audit.scanWorkspace", "when": "view == audit.annotations", "group": "navigation" },
        { "command": "audit.refreshViews", "when": "view == audit.annotations", "group": "navigation" },
        { "command": "audit.clearBookmarks", "when": "view == audit.bookmarks", "group": "navigation" },
        { "command": "audit.syncObsidian", "when": "view == audit.knowledge", "group": "navigation" }
      ],
      "editor/context": [
        { "command": "audit.addAnnotation", "group": "audit@1" },
        { "command": "audit.toggleBookmark", "group": "audit@2" },
        { "command": "audit.exportObsidian", "group": "audit@3" }
      ]
    },
    "keybindings": [
      { "command": "audit.exportObsidian", "key": "ctrl+shift+o", "when": "editorTextFocus" },
      { "command": "audit.toggleBookmark", "key": "ctrl+alt+k", "when": "editorTextFocus" }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": { "better-sqlite3": "^11.0.0" },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  }
}
